<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Palmyra Mediterranean Food</title>
    <link rel="stylesheet" href="stylesheets/base.css">
    <link rel="stylesheet" href="stylesheets/nav-styles.css">
    <link rel="stylesheet" href="stylesheets/hero.css">
    <link rel="stylesheet" href="stylesheets/menu.css">
    <link rel="stylesheet" href="stylesheets/reviews.css">
    <link rel="stylesheet" href="stylesheets/catering.css">
    <link rel="stylesheet" href="stylesheets/events.css">
    <link rel="stylesheet" href="stylesheets/buttons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Condiment&family=Gloria+Hallelujah&family=Kaushan+Script&family=Playwrite+RO:wght@100..400&family=Sacramento&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">
</head>

<body>

    <%- include ('partials/_navbar.ejs') %>

        <main>

            <div class="hero-container">
                <div id="logo">
                    <img src="/images/owner.jpg" alt="">
                </div>
                <div id="story">
                    <h2>Our Story</h2>
                    <p>At Palmyra, we're passionate about bringing authentic Syrian flavors to our community. Our journey began during the Syrian conflict, inspired by a heartfelt mission: to share our cherished family recipes with busy families seeking delicious, healthy meals without the hassle of cooking. Starting from humble beginnings, we've crafted a menu that honors our rich heritage using fresh, locally-sourced ingredients. Come experience the warmth and authentic flavors of Mediterranean cuisine at Palmyra!
                    </p>
                </div>
            </div>

            <h2 id="menu" class="section-label">
                Our Delicious Food Menu
            </h2>

            <hr class="section-hr">

            <% if(userIsAuthorized) { %>

                <a class="crud-btn create-btn" href="/menu-items/create">
                    Create New Menu Item
                </a>

                <% } %>

                    <section class="menu-section">

                        <%- include ('partials/_menu.ejs') %>

                    </section>

                    <h2 id="reviews" class="section-label">See What Our Customers Are Saying</h2>

                    <hr class="section-hr">

                    <section class="review-section">

                        <%- include ('partials/_review-widget.ejs') %>

                    </section>

                    <h2 id="contact" class="section-label">We Do Catering!</h2>

                    <hr class="section-hr">

                    <section class="contact-section">

                        <%- include ('partials/_contact.ejs') %>

                    </section>

                    <h2 id="events" class="section-label">
                        Upcoming Events
                    </h2>

                    <hr class="section-hr">

                    <% if(userIsAuthorized) { %>

                        <a class="crud-btn create-btn" href="/events/create">Create New Event</a>

                        <% } %>

                            <section class="event-section">


                                <%- include ('partials/_events.ejs') %>

                            </section>

        </main>
        <footer>
            <div class="footer-content">
                <p>Copyright &copy; 2024 Palmyra LLC</p>
                <div class="footer-social-links">
                    <a href="https://www.facebook.com/palmyraLLC?mibextid=LQQJ4d" target="_blank" rel="noopener noreferrer">
                        <img src="images/facebook-logo.png" alt="Facebook">
                    </a>
                    <a href="https://www.instagram.com/palmyrallcfoodservice/" target="_blank" rel="noopener noreferrer">
                        <img src="images/instagram-logo.png" alt="Instagram">
                    </a>
                    <a href="https://www.tiktok.com/@palmyra904?_t=8oIsBj0bwU6&_r=1" target="_blank" rel="noopener noreferrer">
                        <img src="/images/tiktok-logo.png" alt="TikTok">
                    </a>
                </div>
            </div>
        </footer>

</body>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="scripts/scripts.js"></script>

</html>