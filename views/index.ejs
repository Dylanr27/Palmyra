<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Palmyra Mediterranean Food</title>
    <link rel="stylesheet" href="stylesheets/style.css">
    <link rel="stylesheet" href="stylesheets/nav-styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
        rel="stylesheet">
</head>

<body>

    <%- include ('partials/_navbar.ejs') %>

    <main>

        <div id="nav-gap"></div>

        <div class="hero-container">
            <div>
                <img src="/images/owner.jpg" alt="">
            </div>
            <div>
                <h2>Our Story</h2>
                <p>Palmyra Mediterranean Food is a family-owned business that specializes in authentic Mediterranean
                    cuisine. Our dishes are made with fresh, locally-sourced ingredients and are prepared with care and
                    attention to detail. We take pride in offering our customers a taste of the Mediterranean right here
                    in the heart of the Pacific Northwest. Whether you're looking for a quick and healthy meal on the go
                    or a leisurely dining experience with friends and family, Palmyra Mediterranean Food has something for
                    everyone. Come visit us today and experience the flavors of the Mediterranean for yourself!</p>
            </div>
        </div>

        <h2 id="menu" class="section-label">
            Food Menu
        </h2>

        <hr class="section-hr">

        <% if(userIsAuthorized) { %>

            <a class="crud-btn create-btn" href="/menu-items/create">Create New Menu Item</a>

        <% } %>

        <section class="menu-section">

            <%- include ('partials/_menu.ejs') %>

        </section>

        <h2 class="section-label">Reviews</h2>

        <hr class="section-hr">

        <section class="review-section">

            <%- include ('partials/_review-widget.ejs') %>

        </section>

        <h2 id="contact" class="section-label">Contact Us</h2>

        <hr class="section-hr">

        <section class="contact-section">

            <%- include ('partials/_contact.ejs') %>

        </section>

        <h2 class="section-label">
            Savor the Flavor: A Photo Journey Through
            Palmyra's Delicious Dishes
        </h2>

        <hr class="section-hr">

        <% if(userIsAuthorized) { %>

            <a class="crud-btn create-btn" href="/photos/create?group=Business">Add New Business Photo</a>

        <% } %>

        <section class="gallery-section">

            <%- include ('partials/_business-snapshots.ejs') %>

        </section>

        <h2 class="section-label">
            Foodie Snapshots
        </h2>

        <hr class="section-hr">

        <% if(userIsAuthorized) { %>

            <a class="crud-btn create-btn" href="/photos/create?group=Customer">Add New Customer Photo</a>

        <% } %>

        <section class="snapshot-section">

            <%- include ('partials/_customer-snapshots.ejs') %>

        </section>

        <h2 class="section-label">
            Social
        </h2>

        <hr class="section-hr">

        <section class="social-section">

            <%- include ('partials/_social.ejs') %>

        </section>

        <h2 id="events" class="section-label">
            Events
        </h2>

        <hr class="section-hr">

        <% if(userIsAuthorized) { %>

            <a class="crud-btn create-btn" href="/events/create">Create New Event</a>

        <% } %>

        <section class="event-section">


            <%- include ('partials/_events.ejs') %>

        </section>

    </main>

</body>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="scripts/scripts.js"></script>
</html>