<% businessPhotos.forEach(function(photo) { %>

    <div>

        <img src="<%= photo.url %>" alt="<%= photo.alt %>" class="gallery-image">

        <% if(userIsAuthorized) { %>

            <button onClick="Delete('/photos/delete/<%= photo._id %>')" class="crud-btn delete-btn">
                Delete
            </button>

        <% } %>

    </div>

<% }); %>