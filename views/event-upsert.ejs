<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= typeof event !=='undefined' ? "Update Event" : "Create Event" %></title>
        <link rel="stylesheet" href="/stylesheets/event-styles.css">
    </head>
    <body>
        <section class="form-section">
            <h1><%= typeof event !=='undefined' ? "Update Event" : "Create Event" %></h1>
            <form action="<%= typeof event !== 'undefined' ? `/events/update/${event.id}` : '/events/createEvent' %>" method="POST">
                <% if (typeof event !== 'undefined') { %>
                    <input type="hidden" name="id" value="<%= event.id %>">
                <% } %>
                <div class="form-group">
                    <label for="title">Title:</label>
                    <input type="text" id="title" name="title" value="<%= typeof event !== 'undefined' ? event.title : '' %>" required>
                </div>
                <div class="date-time-group">
                    <div class="form-group">
                        <label for="date">Date:</label>
                        <input type="date" id="date" name="date" value="<%= typeof event !== 'undefined' ? event.date.toISOString().split('T')[0] : '' %>" required>
                    </div>
                    <div class="form-group">
                        <label for="timeFrame">Time-Frame:</label>
                        <input type="text" id="timeFrame" name="timeFrame" value="<%= typeof event !== 'undefined' ? event.timeFrame : '' %>" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="description">Description:</label>
                    <textarea id="description" name="description" required><%= typeof event !== 'undefined' ? event.description : '' %></textarea>
                </div>
                <fieldset class="location-fieldset">
                    <legend>Location</legend>
                    <div class="form-group">
                        <label for="street">Street:</label>
                        <input type="text" id="street" name="location[street]" value="<%= typeof event !== 'undefined' ? event.location.street : '' %>" required>
                    </div>
                    <div class="location-group">
                        <div class="form-group">
                            <label for="city">City:</label>
                            <input type="text" id="city" name="location[city]" value="<%= typeof event !== 'undefined' ? event.location.city : '' %>" required>
                        </div>
                        <div class="form-group">
                            <label for="state">State:</label>
                            <select id="state" name="location[state]" required>
                                <option value="WA" <%= typeof event !== 'undefined' && event.location.state === 'WA' ? 'selected' : '' %>>Washington</option>
                                <option value="AL" <%= typeof event !== 'undefined' && event.location.state === 'AL' ? 'selected' : '' %>>Alabama</option>
                                <option value="AK" <%= typeof event !== 'undefined' && event.location.state === 'AK' ? 'selected' : '' %>>Alaska</option>
                                <option value="AZ" <%= typeof event !== 'undefined' && event.location.state === 'AZ' ? 'selected' : '' %>>Arizona</option>
                                <option value="AR" <%= typeof event !== 'undefined' && event.location.state === 'AR' ? 'selected' : '' %>>Arkansas</option>
                                <option value="CA" <%= typeof event !== 'undefined' && event.location.state === 'CA' ? 'selected' : '' %>>California</option>
                                <option value="CO" <%= typeof event !== 'undefined' && event.location.state === 'CO' ? 'selected' : '' %>>Colorado</option>
                                <option value="CT" <%= typeof event !== 'undefined' && event.location.state === 'CT' ? 'selected' : '' %>>Connecticut</option>
                                <option value="DE" <%= typeof event !== 'undefined' && event.location.state === 'DE' ? 'selected' : '' %>>Delaware</option>
                                <option value="FL" <%= typeof event !== 'undefined' && event.location.state === 'FL' ? 'selected' : '' %>>Florida</option>
                                <option value="GA" <%= typeof event !== 'undefined' && event.location.state === 'GA' ? 'selected' : '' %>>Georgia</option>
                                <option value="HI" <%= typeof event !== 'undefined' && event.location.state === 'HI' ? 'selected' : '' %>>Hawaii</option>
                                <option value="ID" <%= typeof event !== 'undefined' && event.location.state === 'ID' ? 'selected' : '' %>>Idaho</option>
                                <option value="IL" <%= typeof event !== 'undefined' && event.location.state === 'IL' ? 'selected' : '' %>>Illinois</option>
                                <option value="IN" <%= typeof event !== 'undefined' && event.location.state === 'IN' ? 'selected' : '' %>>Indiana</option>
                                <option value="IA" <%= typeof event !== 'undefined' && event.location.state === 'IA' ? 'selected' : '' %>>Iowa</option>
                                <option value="KS" <%= typeof event !== 'undefined' && event.location.state === 'KS' ? 'selected' : '' %>>Kansas</option>
                                <option value="KY" <%= typeof event !== 'undefined' && event.location.state === 'KY' ? 'selected' : '' %>>Kentucky</option>
                                <option value="LA" <%= typeof event !== 'undefined' && event.location.state === 'LA' ? 'selected' : '' %>>Louisiana</option>
                                <option value="ME" <%= typeof event !== 'undefined' && event.location.state === 'ME' ? 'selected' : '' %>>Maine</option>
                                <option value="MD" <%= typeof event !== 'undefined' && event.location.state === 'MD' ? 'selected' : '' %>>Maryland</option>
                                <option value="MA" <%= typeof event !== 'undefined' && event.location.state === 'MA' ? 'selected' : '' %>>Massachusetts</option>
                                <option value="MI" <%= typeof event !== 'undefined' && event.location.state === 'MI' ? 'selected' : '' %>>Michigan</option>
                                <option value="MN" <%= typeof event !== 'undefined' && event.location.state === 'MN' ? 'selected' : '' %>>Minnesota</option>
                                <option value="MS" <%= typeof event !== 'undefined' && event.location.state === 'MS' ? 'selected' : '' %>>Mississippi</option>
                                <option value="MO" <%= typeof event !== 'undefined' && event.location.state === 'MO' ? 'selected' : '' %>>Missouri</option>
                                <option value="MT" <%= typeof event !== 'undefined' && event.location.state === 'MT' ? 'selected' : '' %>>Montana</option>
                                <option value="NE" <%= typeof event !== 'undefined' && event.location.state === 'NE' ? 'selected' : '' %>>Nebraska</option>
                                <option value="NV" <%= typeof event !== 'undefined' && event.location.state === 'NV' ? 'selected' : '' %>>Nevada</option>
                                <option value="NH" <%= typeof event !== 'undefined' && event.location.state === 'NH' ? 'selected' : '' %>>New Hampshire</option>
                                <option value="NJ" <%= typeof event !== 'undefined' && event.location.state === 'NJ' ? 'selected' : '' %>>New Jersey</option>
                                <option value="NM" <%= typeof event !== 'undefined' && event.location.state === 'NM' ? 'selected' : '' %>>New Mexico</option>
                                <option value="NY" <%= typeof event !== 'undefined' && event.location.state === 'NY' ? 'selected' : '' %>>New York</option>
                                <option value="NC" <%= typeof event !== 'undefined' && event.location.state === 'NC' ? 'selected' : '' %>>North Carolina</option>
                                <option value="ND" <%= typeof event !== 'undefined' && event.location.state === 'ND' ? 'selected' : '' %>>North Dakota</option>
                                <option value="OH" <%= typeof event !== 'undefined' && event.location.state === 'OH' ? 'selected' : '' %>>Ohio</option>
                                <option value="OK" <%= typeof event !== 'undefined' && event.location.state === 'OK' ? 'selected' : '' %>>Oklahoma</option>
                                <option value="OR" <%= typeof event !== 'undefined' && event.location.state === 'OR' ? 'selected' : '' %>>Oregon</option>
                                <option value="PA" <%= typeof event !== 'undefined' && event.location.state === 'PA' ? 'selected' : '' %>>Pennsylvania</option>
                                <option value="RI" <%= typeof event !== 'undefined' && event.location.state === 'RI' ? 'selected' : '' %>>Rhode Island</option>
                                <option value="SC" <%= typeof event !== 'undefined' && event.location.state === 'SC' ? 'selected' : '' %>>South Carolina</option>
                                <option value="SD" <%= typeof event !== 'undefined' && event.location.state === 'SD' ? 'selected' : '' %>>South Dakota</option>
                                <option value="TN" <%= typeof event !== 'undefined' && event.location.state === 'TN' ? 'selected' : '' %>>Tennessee</option>
                                <option value="TX" <%= typeof event !== 'undefined' && event.location.state === 'TX' ? 'selected' : '' %>>Texas</option>
                                <option value="UT" <%= typeof event !== 'undefined' && event.location.state === 'UT' ? 'selected' : '' %>>Utah</option>
                                <option value="VT" <%= typeof event !== 'undefined' && event.location.state === 'VT' ? 'selected' : '' %>>Vermont</option>
                                <option value="VA" <%= typeof event !== 'undefined' && event.location.state === 'VA' ? 'selected' : '' %>>Virginia</option>
                                <option value="WV" <%= typeof event !== 'undefined' && event.location.state === 'WV' ? 'selected' : '' %>>West Virginia</option>
                                <option value="WI" <%= typeof event !== 'undefined' && event.location.state === 'WI' ? 'selected' : '' %>>Wisconsin</option>
                                <option value="WY" <%= typeof event !== 'undefined' && event.location.state === 'WY' ? 'selected' : '' %>>Wyoming</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="zipCode">Zip Code:</label>
                            <input type="text" id="zipCode" name="location[zipCode]" value="<%= typeof event !== 'undefined' ? event.location.zipCode : '' %>" required>
                        </div>
                    </div>
                </fieldset>
                <div class="button-group">
                    <button type="submit" class="form-button"><%= typeof event !=='undefined' ? "Update" : "Create" %></button>
                    <a class="cancel-button" href="/">Cancel</a>
                </div>
                <div hidden class="form-group">
                    <label for="country">Country:</label>
                    <input type="text" id="country" name="location[country]" value="<%= typeof event !== 'undefined' ? event.location.country : 'USA' %>" required>
                </div>
            </form>
        </section>
    </body>
</html>