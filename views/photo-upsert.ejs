<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof photo !== 'undefined' ? "Update Photo" : "Create Photo" %></title>
    <link rel="stylesheet" href="/stylesheets/photo-styles.css">
</head>
<body>
    <section class="form-section">
        <h1><%= typeof photo !== 'undefined' ? "Update Photo" : "Create Photo" %></h1>
        <form action="<%= typeof photo !== 'undefined' ? `/photos/update/${photo._id}` : '/photos/createPhoto' %>" method="POST" enctype="multipart/form-data">
            <% if (typeof photo !== 'undefined') { %>
                <input type="hidden" name="id" value="<%= photo._id %>">
            <% } %>
            <div class="form-group">
                <label for="alt">Description:</label>
                <textarea id="alt" name="alt" required><%= typeof photo !== 'undefined' ? photo.alt : '' %></textarea>
            </div>
            <div class="form-group">
                <label for="url">Image:</label>
                <input type="file" id="url" name="url" required>
            </div>
            <div class="form-group">
                <label for="group">Group:</label>
                <input type="text" id="group" name="group" value="<%= group %>" required hidden>
                <input disabled type="text" id="group" name="group" value="<%= group %>" required>
            </div>
            <div class="form-group">
                <label for="gridOrder">Order photo will appear in grid</label>
                <select id="gridOrder" name="gridOrder" required>
                    <% for(let i = 0; i < photoCount + 1; i++){ %>
                        <% if(typeof photo === 'undefined' && i === photoCount) { %>
                            <!-- In create mode, set the default selected option to photoCount + 1 -->
                            <option value="<%= i %>" selected><%= i + 1 %></option>
                        <% } else { %>
                            <option value="<%= i %>" <%= typeof photo !== 'undefined' && photo.gridOrder === i ? 'selected' : '' %>><%= i + 1 %></option>
                        <% } %>
                    <% } %>
                </select>
            </div>
            <div class="button-group">
                <button type="submit" class="form-button"><%= typeof photo !== 'undefined' ? "Update" : "Create" %></button>
                <a href="/" class="cancel-button">Cancel</a>
            </div>
        </form>
    </section>
</body>
</html>