<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof menuItem !=='undefined' ? "Update Menu Item" : "Create Menu Item" %></title>
    <link rel="stylesheet" href="/stylesheets/menu-item-styles.css">
</head>
<body>
    <section class="form-section">
        <h1><%= typeof menuItem !=='undefined' ? "Update Menu Item" : "Create Menu Item" %></h1>
        <form action="<%= typeof menuItem !== 'undefined' ? `/menu-items/update/${menuItem.id}` : '/menu-items/createMenuItem' %>" method="POST">
            <% if (typeof menuItem !== 'undefined') { %>
                <input type="hidden" name="id" value="<%= menuItem.id %>">
            <% } %>
            <div class="form-group">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" value="<%= typeof menuItem !== 'undefined' ? menuItem.name : '' %>" required>
            </div>
            <div class="form-group">
                <label for="price">Price:</label>
                <input type="number" id="price" name="price" value="<%= typeof menuItem !== 'undefined' ? menuItem.price : '' %>" required min="0">
            </div>
            <div class="form-group">
                <label for="description">Description (Optional):</label>
                <textarea id="description" name="description"><%= typeof menuItem !== 'undefined' ? menuItem.description : '' %></textarea>
            </div>
            <div class="form-group">
                <label for="image">Image (Optional):</label>
                <input type="file" id="image" name="image" value="<%= typeof menuItem !== 'undefined' ? menuItem.image : '' %>">
            </div>
            <div class="button-group">
                <button type="submit" class="form-button">Save</button>
                <a href="/" class="cancel-button">Cancel</a>
            </div>
        </form>
    </section>
</body>
</html>