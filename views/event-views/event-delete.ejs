<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete Event</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <section class="form-section">
        <h1>Delete Event</h1>
        <form action="/events/delete/<%= event.id %>" method="POST">
            <div class="form-group">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" value="<%= event.title %>" disabled>
            </div>
            <div class="form-group">
                <label for="date">Date:</label>
                <input type="date" id="date" name="date" value="<%= event.date %>" disabled>
            </div>
            <div class="form-group">
                <label for="description">Description:</label>
                <textarea id="description" name="description" disabled><%= event.description %></textarea>
            </div>
            <button type="submit" class="form-button">Confirm Delete</button>
            <a href="/events" class="cancel-button">Cancel</a>
        </form>
    </section>
</body>
</html>