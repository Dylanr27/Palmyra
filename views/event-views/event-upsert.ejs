<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= event ? "Update Event" : "Create Event" %></title>
    <link rel="stylesheet" href="/stylesheets/event-styles.css">
</head>
<body>
    <section class="form-section">
        <h1><%= event ? "Update Event" : "Create Event" %></h1>
        <form action="<%= event ? `/events/update/${event.id}` : '/events/create' %>" method="POST">
            <div class="form-group">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" value="<%= event ? event.title : '' %>" required>
            </div>
            <div class="form-group">
                <label for="date">Date:</label>
                <% console.log("date" + event.date) %>
                <input type="date" id="date" name="date" value="<%= event ? event.date : '' %>" required>
            </div>
            <div class="form-group">
                <label for="description">Description:</label>
                <textarea id="description" name="description" required><%= event ? event.description : '' %></textarea>
            </div>
            <button type="submit" class="form-button"><%= event ? "Update" : "Create" %></button>
        </form>
    </section>
</body>
</html>