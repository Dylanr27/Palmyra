<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof event !=='undefined' ? "Update Event" : "Create Event" %></title>
    <link rel="stylesheet" href="/stylesheets/event-styles.css">
</head>
<body>
    <section class="form-section">
        <h1><%= typeof event !=='undefined' ? "Update Event" : "Create Event" %></h1>
        <form action="<%= typeof event !== 'undefined' ? `/events/update/${event._id}` : '/events/createEvent' %>" method="POST">
            <% if (typeof event !== 'undefined') { %>
                <input type="hidden" name="id" value="<%= event._id %>">
            <% } %>
            <div class="form-group">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" value="<%= typeof event !== 'undefined' ? event.title : '' %>" required>
            </div>
            <div class="form-group">
                <label for="date">Date:</label>
                <input type="date" id="date" name="date" value="<%= typeof event !== 'undefined' ? event.date.toISOString().split('T')[0] : '' %>" required>
            </div>
            <div class="form-group">
                <label for="timeFrame">Time-Frame:</label>
                <input type="text" id="timeFrame" name="timeFrame" value="<%= typeof event !== 'undefined' ? event.timeFrame : '' %>" required>
            </div>
            <div class="form-group">
                <label for="description">Description:</label>
                <textarea id="description" name="description" required><%= typeof event !== 'undefined' ? event.description : '' %></textarea>
            </div>
            <!-- Location Fields -->
            <fieldset>
                <legend>Location</legend>
                <div class="form-group">
                    <label for="street">Street:</label>
                    <input type="text" id="street" name="location[street]" value="<%= typeof event !== 'undefined' ? event.location.street : '' %>" required>
                </div>
                <div class="form-group">
                    <label for="city">City:</label>
                    <input type="text" id="city" name="location[city]" value="<%= typeof event !== 'undefined' ? event.location.city : '' %>" required>
                </div>
                <div class="form-group">
                    <label for="state">State:</label>
                    <input type="text" id="state" name="location[state]" value="<%= typeof event !== 'undefined' ? event.location.state : '' %>" required>
                </div>
                <div class="form-group">
                    <label for="zipCode">Zip Code:</label>
                    <input type="text" id="zipCode" name="location[zipCode]" value="<%= typeof event !== 'undefined' ? event.location.zipCode : '' %>" required>
                </div>
                <div hidden class="form-group">
                    <label for="country">Country:</label>
                    <input type="text" id="country" name="location[country]" value="<%= typeof event !== 'undefined' ? event.location.country : 'USA' %>" required>
                </div>
            </fieldset>
            <button type="submit" class="form-button"><%= typeof event !=='undefined' ? "Update" : "Create" %></button>
        </form>
    </section>
</body>
</html>